# Local:  run `npm run db:start` and copy the API URL and Publishable key it prints.
# Cloud:  Supabase dashboard > Connect (or Settings > API Keys).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Trusted shell ONLY for `npm run seed:demo` (never prefix these with VITE_).
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<local service_role or server secret key>
# DEMO_EMPLOYEE_PASSWORD=SecurityDemo!2026
# DEMO_ADMIN_PASSWORD=AdminSecure!2026
# Optional for `node scripts/verify-demo-logins.mjs`:
# SUPABASE_PUBLISHABLE_KEY=<same publishable key as frontend>
