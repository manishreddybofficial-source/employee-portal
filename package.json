{
  "name": "employee-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:release": "node scripts/verify-release.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:test": "supabase db query --linked --file tests/database.sql",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:seed": "node --test scripts/demo-seed.test.mjs",
    "verify:demo": "node scripts/verify-demo-logins.mjs",
    "db:test:local": "node scripts/test-database.mjs",
    "db:test:security": "supabase db query --linked --file tests/security-database.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "supabase": "^2.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
